{
  "private": true,
  "type": "module",
  "devDependencies": {
    "axe-core": "4.14.0",
    "linkedom": "0.18.12",
    "playwright-core": "1.64.1"
  },
  "scripts": {
    "lab:build": "node demos/frontend-lab/build.mjs",
    "lab:test": "node demos/frontend-lab/tests.mjs && node demos/frontend-lab/tests.mjs --bundle",
    "lab:preview": "node scripts/preview-frontend.mjs",
    "experience:build": "node demos/experience-lab/build.mjs",
    "experience:test": "node demos/experience-lab/tests.mjs && node demos/experience-lab/tests.mjs --bundle",
    "experience:preview": "node scripts/preview-frontend.mjs --experience",
    "test": "node --test tests/js/*.test.js tests/e2e/fixtures/synthetic-media.test.js tests/e2e/visible-harness/*.test.js",
    "test:encoding-performance": "node scripts/check-encoding-performance.mjs"
  }
